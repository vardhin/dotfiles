#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
// rmpc, the mpd client: rmpc's defaults, plus the theme Dot Shell writes for
// the era (themes/dotshell.ron, from services/Export.qml). Hot-reloaded.
(
    address: "127.0.0.1:6600",
    theme: "dotshell",
    enable_config_hot_reload: true,
)
