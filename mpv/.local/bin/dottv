#!/usr/bin/env python3
"""dottv: Dot TV, a YouTube library played by mpv (the old AGS Media Center).

  dottv open                      show the player window (it starts without one:
                                  Dot Shell's MEDIA pane shows the picture)
  dottv play ID|URL [--queue|--next]
                                  play now; --queue appends, --next plays after
                                  this one. Not in the library yet: streams it
                                  and saves it in the background
  dottv get ID|URL                save to the library (no playback)
  dottv search QUERY [-n 8] [--json]
  dottv lib [--json]              the library, most played first
  dottv rm ID                     delete a saved video (and its list entries)
  dottv mix [on|off|toggle]       Endless Mix: shuffled library, never stops
  dottv queue [--json]            what plays next
  dottv clear                     empty the queue (keeps what is playing)
  dottv list [--json]             playlists
  dottv list NAME                 its tracks
  dottv list new NAME | drop NAME
  dottv list add|del|toggle NAME ID...
  dottv list play NAME [--shuffle]
  dottv led [on|off|toggle|reload]  the LED dot shader (era colors from Dot Shell)
  dottv thumbs                    fetch missing thumbnails
  dottv status --json             player state for Dot Shell
  dottv sync [--here]             fetch new songs from YouTube Music (in the
                                  background; --here waits and prints)
  dottv music                     reindex the songs and stations; fill in
                                  missing titles, durations and thumbnails

The library is ${DOTTV_DIR:-~/Video/TV}: <id>-<height>.mp4, video-meta.json,
playlists.json, play-counts.json, thumbs/<id>.jpg. The player is mpv on
$XDG_RUNTIME_DIR/dottv.sock with scripts/dottv.lua (titles, play counts,
Endless Mix, the L key); mpv-mpris puts it on MPRIS like any player. It runs
without video until `dottv open`: the MEDIA pane plays the saved file itself,
muted and kept in time with mpv.

Songs come from ytmusic-helper (its sync_ytmusic.py), linked at
${DOTTV_MUSIC:-~/Music/ytmusic}: .music-cache/<id>.mp3 join the library as
audio, keyed by the same YouTube id, and stations/*/station.json become
read-only lists (LIB/stations.json, rebuilt by `lib`, `music` and `sync`).
"""
import fcntl
import json
import os
import random
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.parse
import urllib.request
import uuid

HOME = os.path.expanduser("~")
LIB = os.path.expanduser(os.environ.get("DOTTV_DIR", "~/Video/TV"))
META = os.path.join(LIB, "video-meta.json")
LISTS = os.path.join(LIB, "playlists.json")
COUNTS = os.path.join(LIB, "play-counts.json")
THUMBS = os.path.join(LIB, "thumbs")
OLD_THUMBS = os.path.join(os.environ.get("XDG_CACHE_HOME", HOME + "/.cache"), "ags-yt-thumbs")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
SOCK = os.path.join(RUNTIME, "dottv.sock")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", HOME + "/.local/state"), "dotshell")
LED_OPTS = os.path.join(STATE, "mpv-led.conf")
SHADER = "~~/shaders/dotled.glsl"
MUSIC = os.path.expanduser(os.environ.get("DOTTV_MUSIC", "~/Music/ytmusic")).rstrip("/")
SONGS = os.path.join(MUSIC, ".music-cache")
STATION_DIR = os.path.join(MUSIC, "stations")
STATIONS = os.path.join(LIB, "stations.json")
SYNC_LOG = os.path.join(STATE, "ytmusic-sync.log")
SYNC_LOCK = os.path.join(STATE, "ytmusic-sync.lock")
FILE_RE = re.compile(r"^(.+)-(\d{3,4})\.mp4$")
SONG_RE = re.compile(r"^([A-Za-z0-9_-]{11})\.mp3$")
ID_RE = re.compile(r"^[A-Za-z0-9_-]{11}$")
# Progressive or merged mp4 up to 480p, as the Media Center kept them. H.264
# first: the shell draws these with Qt Multimedia, whose ffmpeg picks the
# hardware-only AV1 decoder and shows nothing for AV1 (mpv plays it fine).
FORMAT = "bv*[height<=480][vcodec^=avc1]+ba[ext=m4a]/b[height<=480][vcodec^=avc1]/bv*[height<=480][ext=mp4]+ba[ext=m4a]/b[height<=480][ext=mp4]/bv*[height<=480]+ba/b[height<=480]/b"


def die(msg, code=1):
    print(f"dottv: {msg}", file=sys.stderr)
    sys.exit(code)


# ── Library files ───────────────────────────────────────────────────────
def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save(path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        json.dump(value, f, indent=2, ensure_ascii=False)
    os.replace(tmp, path)


class Locked:
    """Read-modify-write of one JSON file, safe across dottv processes."""

    def __init__(self, path, default):
        self.path, self.default = path, default

    def __enter__(self):
        os.makedirs(LIB, exist_ok=True)
        self.lock = open(os.path.join(LIB, ".dottv.lock"), "w")
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        self.value = load(self.path, self.default)
        return self.value

    def __exit__(self, kind, *_):
        if kind is None:
            save(self.path, self.value)
        fcntl.flock(self.lock, fcntl.LOCK_UN)
        self.lock.close()


def listdir(path):
    try:
        return os.listdir(path)
    except (FileNotFoundError, NotADirectoryError):
        return []


def files():
    """id -> {quality: path}, plus the earliest mtime as `added`. A song from
    YouTube Music is quality 0: any saved video of the same id wins."""
    out = {}
    found = [(os.path.join(LIB, n), FILE_RE.match(n)) for n in listdir(LIB)]
    found += [(os.path.join(SONGS, n), SONG_RE.match(n)) for n in listdir(SONGS)]
    for path, m in found:
        if not m:
            continue
        e = out.setdefault(m[1], {"q": {}, "added": float("inf")})
        e["q"][int(m[2]) if m.re is FILE_RE else 0] = path
        e["added"] = min(e["added"], os.path.getmtime(path))
    return out


def path_id(path):
    """The YouTube id of a library file, or None."""
    name = os.path.basename(path or "")
    m = FILE_RE.match(name)
    if m:
        return m[1]
    m = SONG_RE.match(name)
    return m[1] if m and os.path.dirname(path) == SONGS else None


def best_file(vid):
    e = files().get(vid)
    return e["q"][max(e["q"])] if e else None


def thumb(vid):
    for p in (os.path.join(THUMBS, vid + ".jpg"), os.path.join(OLD_THUMBS, vid + ".jpg")):
        if os.path.exists(p):
            return p
    return ""


def library():
    meta, counts = load(META, {}), load(COUNTS, {})
    rows = []
    for vid, e in files().items():
        m = meta.get(vid, {})
        rows.append({
            "id": vid,
            "title": m.get("title") or vid,
            "channel": m.get("channel", ""),
            "duration": m.get("duration", ""),
            "plays": int(counts.get(vid, 0) or 0),
            "added": int(e["added"]),
            "quality": max(e["q"]),
            "audio": max(e["q"]) == 0,
            "path": e["q"][max(e["q"])],
            "thumb": thumb(vid),
        })
    rows.sort(key=lambda r: (-r["plays"], r["title"].lower()))
    return rows


def video_id(s):
    s = s.strip()
    if ID_RE.match(s):
        return s
    m = re.search(r"(?:v=|youtu\.be/|shorts/|/embed/)([A-Za-z0-9_-]{11})", s)
    if m:
        return m[1]
    die(f"not a YouTube id or link: {s!r}")


def watch(vid):
    return f"https://www.youtube.com/watch?v={vid}"


# ── mpv ─────────────────────────────────────────────────────────────────
class Mpv:
    def __init__(self, start=True, window=False):
        self.sock = None
        self.req = 0
        if not self.connect() and start:
            self.launch(window)

    def connect(self):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.connect(SOCK)
        except OSError:
            return False
        self.sock, self.buf = s, b""
        return True

    def launch(self, window=False):
        args = [
            "mpv", "--idle=yes", "--wayland-app-id=dottv",
            "--force-window=yes" if window else "--force-window=no",
            "--vid=auto" if window else "--vid=no",
            "--title=${?media-title:${media-title}}${!media-title:DOT TV}",
            f"--input-ipc-server={SOCK}", f"--script-opts=dottv-library={LIB},dottv-music={SONGS}",
            f"--ytdl-format={FORMAT}", "--really-quiet",
        ]
        if os.path.exists(LED_OPTS):
            args.append(f"--include={LED_OPTS}")
        subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        for _ in range(50):
            time.sleep(0.1)
            if self.connect():
                return
        die("mpv did not start (is mpv installed?)")

    @property
    def up(self):
        return self.sock is not None

    def __call__(self, *cmd):
        self.req += 1
        rid = self.req
        self.sock.sendall((json.dumps({"command": list(cmd), "request_id": rid}) + "\n").encode())
        while True:
            while b"\n" not in self.buf:
                chunk = self.sock.recv(65536)
                if not chunk:
                    die("mpv closed the connection")
                self.buf += chunk
            line, self.buf = self.buf.split(b"\n", 1)
            msg = json.loads(line)
            if msg.get("request_id") == rid:
                if msg.get("error") not in ("success", None):
                    raise RuntimeError(msg["error"])
                return msg.get("data")

    def get(self, prop, default=None):
        try:
            return self(*["get_property", prop])
        except RuntimeError:
            return default


def focus():
    subprocess.run(["hyprdo", "focus", "class:^(dottv)$"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def notify(summary, body=""):
    subprocess.run(["notify-send", "-a", "Dot TV", "-i", "video-x-generic", summary, body],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ── Saving videos ───────────────────────────────────────────────────────
def get(vid, quiet=False):
    """Download one video into the library with its title and thumbnail."""
    if best_file(vid):
        return True
    os.makedirs(THUMBS, exist_ok=True)
    out = subprocess.run([
        "yt-dlp", "--no-warnings", "--no-playlist", "--no-progress", "-f", FORMAT,
        "--merge-output-format", "mp4", "--embed-metadata",
        "--write-thumbnail", "--convert-thumbnails", "jpg",
        "-o", os.path.join(LIB, f"{vid}-480.%(ext)s"),
        "-o", f"thumbnail:{os.path.join(THUMBS, vid)}.%(ext)s",
        "--print", "after_move:%(title)s\t%(channel)s\t%(duration_string)s",
        watch(vid),
    ], capture_output=True, text=True)
    lines = [l for l in out.stdout.splitlines() if "\t" in l]
    if out.returncode != 0 or not best_file(vid):
        err = (out.stderr.strip().splitlines() or ["download failed"])[-1]
        if not quiet:
            print(err, file=sys.stderr)
        notify("Could not save the video", err)
        return False
    title, channel, duration = (lines[-1].split("\t") + ["", "", ""])[:3] if lines else ("", "", "")
    with Locked(META, {}) as meta:
        meta[vid] = {"title": title, "channel": channel, "duration": duration}
    notify("Saved to the TV library", title)
    if not quiet:
        print(title or vid)
    return True


def get_in_background(vid):
    subprocess.Popen([sys.argv[0], "get", vid, "--quiet"], stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


# ── Commands ────────────────────────────────────────────────────────────
def cmd_open(args):
    mpv = Mpv(window=True)
    mpv("set_property", "vid", "auto")
    mpv("set_property", "force-window", True)
    if led_state() == "on" and not any(s.endswith("dotled.glsl") for s in (mpv.get("glsl-shaders", []) or [])):
        mpv("set_property", "glsl-shaders", [SHADER])
    time.sleep(0.3)
    focus()


def cmd_play(args):
    how = "replace"
    if "--queue" in args:
        how = "append-play"
    elif "--next" in args:
        how = "insert-next-play"
    rest = [a for a in args if not a.startswith("--")]
    if not rest:
        die("play what? an id or a link")
    vid = video_id(rest[0])
    path = best_file(vid)
    if not path:
        path = watch(vid)
        get_in_background(vid)
    mpv = Mpv()
    mpv("loadfile", path, how)
    if how == "replace":
        mpv("set_property", "pause", False)


def cmd_get(args):
    rest = [a for a in args if not a.startswith("--")]
    if not rest:
        die("get what? an id or a link")
    sys.exit(0 if get(video_id(rest[0]), quiet="--quiet" in args) else 1)


def cmd_search(args):
    n, words, as_json = 8, [], False
    it = iter(args)
    for a in it:
        if a == "-n":
            n = int(next(it, "8"))
        elif a == "--json":
            as_json = True
        else:
            words.append(a)
    q = " ".join(words).strip()
    if not q:
        die("search for what?")
    out = subprocess.run(["yt-dlp", "--flat-playlist", "--dump-json", "--no-warnings",
                          f"ytsearch{n}:{q}"], capture_output=True, text=True)
    saved = files()
    rows = []
    for line in out.stdout.splitlines():
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if not o.get("id"):
            continue
        secs = int(o.get("duration") or 0)
        rows.append({
            "id": o["id"],
            "title": o.get("title") or "?",
            "channel": o.get("channel") or o.get("uploader") or "",
            "duration": f"{secs // 60}:{secs % 60:02d}" if secs else "",
            "saved": o["id"] in saved,
        })
    if as_json:
        print(json.dumps(rows))
        return
    for r in rows:
        print(f"{r['id']}  {r['duration']:>6}  {'*' if r['saved'] else ' '} {r['title']}  ({r['channel']})")


def cmd_lib(args):
    index_music()
    rows = library()
    if "--json" in args:
        print(json.dumps(rows))
        return
    for r in rows:
        print(f"{r['id']}  {r['plays']:>3}x  {r['duration']:>6}  {r['title']}")


def cmd_rm(args):
    if not args:
        die("rm what?")
    vid = video_id(args[0])
    e = files().get(vid)
    if not e:
        die(f"{vid} is not in the library")
    mpv = Mpv(start=False)
    if mpv.up and mpv.get("path") in e["q"].values():
        mpv("playlist-next", "force")
    for p in [*e["q"].values(), os.path.join(THUMBS, vid + ".jpg")]:
        if os.path.exists(p):
            os.remove(p)
    with Locked(META, {}) as meta:
        meta.pop(vid, None)
    with Locked(LISTS, []) as lists:
        for pl in lists:
            pl["itemIds"] = [i for i in pl.get("itemIds", []) if i != vid]
            if pl.get("coverVideoId") == vid:
                pl["coverVideoId"] = pl["itemIds"][0] if pl["itemIds"] else None


def cmd_mix(args):
    mpv = Mpv()
    on = mpv.get("user-data/dottv/mix") is True
    want = args[0] if args else "toggle"
    on = {"on": True, "off": False}.get(want, not on)
    mpv("set_property", "user-data/dottv/mix", on)
    if not on:
        # Stopping the mix drops what it queued, as the Media Center did.
        mpv("playlist-clear")
    print("on" if on else "off")


def entries(mpv):
    meta = load(META, {})
    out = []
    for i, e in enumerate(mpv.get("playlist", []) or []):
        name = os.path.basename(e.get("filename", ""))
        vid = path_id(e.get("filename", ""))
        if not vid and "youtube.com/watch?v=" in e.get("filename", ""):
            vid = e["filename"].split("v=")[1][:11]
        title = (meta.get(vid, {}) if vid else {}).get("title") or e.get("title") or name
        out.append({"index": i, "id": vid or "", "title": title,
                    "current": bool(e.get("current")), "playing": bool(e.get("playing"))})
    return out


def cmd_queue(args):
    mpv = Mpv(start=False)
    rows = entries(mpv) if mpv.up else []
    pos = next((r["index"] for r in rows if r["current"]), -1)
    rows = [r for r in rows if r["index"] > pos]
    if "--json" in args:
        print(json.dumps(rows))
        return
    for n, r in enumerate(rows, 1):
        print(f"{n:>2}  {r['title']}")


def cmd_clear(args):
    mpv = Mpv(start=False)
    if mpv.up:
        mpv("set_property", "user-data/dottv/mix", False)
        mpv("playlist-clear")


def find_list(lists, name):
    low = name.lower()
    return next((p for p in lists if p["id"] == name or p["name"].lower() == low), None)


def cmd_list(args):
    if not args or args[0] == "--json":
        lists = load(LISTS, []) + load(STATIONS, [])
        if args:
            print(json.dumps([{"id": p["id"], "name": p["name"], "count": len(p.get("itemIds", [])),
                               "itemIds": p.get("itemIds", []), "cover": p.get("coverVideoId"),
                               "station": bool(p.get("station"))} for p in lists]))
        else:
            for p in lists:
                print(f"{'♪ ' if p.get('station') else ''}{p['name']}  ({len(p.get('itemIds', []))})")
        return
    verb, rest = args[0], args[1:]
    if verb == "new":
        if not rest:
            die("list new NAME")
        with Locked(LISTS, []) as lists:
            if find_list(lists, rest[0]):
                die(f"there is a list called {rest[0]}")
            lists.append({"id": str(uuid.uuid4()), "name": rest[0], "itemIds": [],
                          "coverVideoId": None, "coverImagePath": None})
    elif verb == "drop":
        with Locked(LISTS, []) as lists:
            pl = find_list(lists, rest[0] if rest else "")
            if not pl:
                die("no such list")
            lists.remove(pl)
    elif verb in ("add", "del", "toggle"):
        if len(rest) < 2:
            die(f"list {verb} NAME ID...")
        with Locked(LISTS, []) as lists:
            pl = find_list(lists, rest[0])
            if not pl:
                if find_list(load(STATIONS, []), rest[0]):
                    die(f"{rest[0]} is a YouTube Music station: `dottv sync` keeps it")
                die(f"no list called {rest[0]}")
            items = pl.setdefault("itemIds", [])
            for vid in map(video_id, rest[1:]):
                has = vid in items
                if verb == "add" or (verb == "toggle" and not has):
                    if not has:
                        items.append(vid)
                elif has:
                    items.remove(vid)
            if pl.get("coverVideoId") not in items:
                pl["coverVideoId"] = items[0] if items else None
            print(json.dumps({"name": pl["name"], "count": len(items)}))
    elif verb == "play":
        lists = load(LISTS, []) + load(STATIONS, [])
        pl = find_list(lists, rest[0] if rest else "")
        if not pl:
            die("no such list")
        ids = [i for i in pl.get("itemIds", []) if best_file(i)]
        if not ids:
            die(f"{pl['name']} has no saved videos")
        if "--shuffle" in rest:
            random.shuffle(ids)
        mpv = Mpv()
        mpv("set_property", "user-data/dottv/mix", False)
        for n, vid in enumerate(ids):
            mpv("loadfile", best_file(vid), "replace" if n == 0 else "append")
        mpv("set_property", "pause", False)
    else:
        lists = load(LISTS, []) + load(STATIONS, [])
        pl = find_list(lists, verb)
        if not pl:
            die(f"no list called {verb}")
        meta = load(META, {})
        for vid in pl.get("itemIds", []):
            print(f"{vid}  {meta.get(vid, {}).get('title', vid)}")


def led_state():
    """'on' or 'off' from Dot Shell's `# dottv-led` line (raw color = off)."""
    try:
        with open(LED_OPTS) as f:
            for line in f:
                if line.startswith("# dottv-led "):
                    return line.split()[-1]
    except OSError:
        pass
    return "on"


def led_opts():
    try:
        with open(LED_OPTS) as f:
            for line in f:
                if line.startswith("glsl-shader-opts="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return None


def cmd_led(args):
    mpv = Mpv(start=False)
    if not mpv.up:
        if args and args[0] == "reload":
            return
        die("Dot TV is not running")
    want = args[0] if args else "toggle"
    opts = led_opts()
    if opts:
        mpv("set_property", "glsl-shader-opts", opts)
    if want == "reload":
        if led_state() == "off":
            shaders = mpv.get("glsl-shaders", []) or []
            mpv("set_property", "glsl-shaders", [s for s in shaders if not s.endswith("dotled.glsl")])
        return
    shaders = mpv.get("glsl-shaders", []) or []
    on = any(s.endswith("dotled.glsl") for s in shaders)
    on = {"on": True, "off": False}.get(want, not on)
    rest = [s for s in shaders if not s.endswith("dotled.glsl")]
    mpv("set_property", "glsl-shaders", rest + ([SHADER] if on else []))
    print("on" if on else "off")


def cmd_thumbs(args):
    os.makedirs(THUMBS, exist_ok=True)
    got = 0
    for vid in files():
        dest = os.path.join(THUMBS, vid + ".jpg")
        if os.path.exists(dest):
            continue
        old = os.path.join(OLD_THUMBS, vid + ".jpg")
        try:
            if os.path.exists(old):
                shutil.copyfile(old, dest)
            else:
                urllib.request.urlretrieve(f"https://i.ytimg.com/vi/{vid}/hqdefault.jpg", dest)
            got += 1
        except OSError as e:
            print(f"{vid}: {e}", file=sys.stderr)
    print(f"{got} thumbnails fetched")


def cmd_status(args):
    mpv = Mpv(start=False)
    if not mpv.up:
        print(json.dumps({"running": False, "mix": False, "led": False, "queue": [], "current": None,
                          "sync": sync_state()}))
        return
    rows = entries(mpv)
    cur = next((r for r in rows if r["current"]), None)
    print(json.dumps({
        "running": True,
        "mix": mpv.get("user-data/dottv/mix") is True,
        "led": any(s.endswith("dotled.glsl") for s in (mpv.get("glsl-shaders", []) or [])),
        "current": cur,
        "queue": [r for r in rows if cur is None or r["index"] > cur["index"]],
        "sync": sync_state(),
    }))


# ── YouTube Music ───────────────────────────────────────────────────────
def index_music():
    """Stations into LIB/stations.json, and song titles from their manifests
    into video-meta.json where it has none. Writes only what changed, so the
    shell, which watches both, does not go round in circles."""
    if not os.path.isdir(STATION_DIR):
        if os.path.exists(STATIONS):
            os.remove(STATIONS)
        return
    order = [s.get("directory") for s in load(os.path.join(STATION_DIR, "stations.json"), {}).get("stations", [])]
    dirs = sorted(d for d in listdir(STATION_DIR) if os.path.isdir(os.path.join(STATION_DIR, d)))
    dirs = [d for d in order if d in dirs] + [d for d in dirs if d not in order]
    stations, info = [], {}
    for d in dirs:
        m = load(os.path.join(STATION_DIR, d, "station.json"), None)
        if not m:
            continue
        ids = []
        for t in m.get("tracks", []):
            vid = t.get("videoId")
            if not vid or vid in ids:
                continue
            ids.append(vid)
            info.setdefault(vid, {"title": t.get("title") or "", "channel": t.get("artist") or "",
                                  "duration": t.get("duration") or ""})
        if ids:
            stations.append({"id": "station:" + d, "name": m.get("name") or d, "itemIds": ids,
                             "coverVideoId": ids[0], "station": True})
    if load(STATIONS, None) != stations:
        save(STATIONS, stations)
    meta = load(META, {})
    if any(not meta.get(v, {}).get("title") for v in info):
        with Locked(META, {}) as meta:
            for vid, i in info.items():
                if not meta.get(vid, {}).get("title"):
                    meta[vid] = i


def songs():
    return {m[1] for m in map(SONG_RE.match, listdir(SONGS)) if m}


def fill_songs():
    """What a manifest leaves out: titles of songs no station lists any more
    (from YouTube), durations (from the file), thumbnails."""
    meta = load(META, {})
    found = {}
    for vid in songs():
        m = dict(meta.get(vid) or {})
        if not m.get("title"):
            try:
                with urllib.request.urlopen("https://www.youtube.com/oembed?format=json&url="
                                            + urllib.parse.quote(watch(vid)), timeout=10) as r:
                    o = json.load(r)
                m["title"] = o.get("title") or ""
                m["channel"] = re.sub(r" - Topic$", "", o.get("author_name") or "")
            except (OSError, ValueError):
                pass
        if not m.get("duration"):
            try:
                secs = int(float(subprocess.run(
                    ["ffprobe", "-v", "quiet", "-show_entries", "format=duration", "-of", "csv=p=0",
                     os.path.join(SONGS, vid + ".mp3")], capture_output=True, text=True).stdout.strip()))
                m["duration"] = f"{secs // 60}:{secs % 60:02d}"
            except (OSError, ValueError):
                pass
        if m != (meta.get(vid) or {}):
            found[vid] = m
    if found:
        with Locked(META, {}) as meta:
            for vid, m in found.items():
                meta[vid] = {**m, **{k: v for k, v in (meta.get(vid) or {}).items() if v}}
    cmd_thumbs([])
    return len(found)


def sync_running():
    try:
        f = open(SYNC_LOCK, "a")
    except OSError:
        return False
    with f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return True
    return False


def sync_state():
    line = ""
    try:
        with open(SYNC_LOG, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 4096))
            tail = [l.strip() for l in f.read().decode(errors="replace").splitlines()]
            line = next((l for l in reversed(tail) if l.strip("= ")), "")
    except OSError:
        pass
    return {"available": os.path.exists(os.path.join(MUSIC, "sync_ytmusic.py")),
            "running": sync_running(), "line": line[:160]}


def cmd_sync(args):
    if not os.path.exists(os.path.join(MUSIC, "sync_ytmusic.py")):
        die(f"no ytmusic-helper at {MUSIC}: link it there, or set DOTTV_MUSIC")
    os.makedirs(STATE, exist_ok=True)
    if "--here" not in args:
        if sync_running():
            die("a sync is already running")
        subprocess.Popen([sys.argv[0], "sync", "--here", "--quiet"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        # Back once it holds the lock, so `status` says it runs from now on.
        for _ in range(30):
            if sync_running():
                return
            time.sleep(0.1)
        return
    lock = open(SYNC_LOCK, "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die("a sync is already running")
    quiet = "--quiet" in args
    before = songs()
    py = os.path.join(MUSIC, ".venv", "bin", "python")
    cmd = [py, "-u", "sync_ytmusic.py"] if os.access(py, os.X_OK) else ["uv", "run", "python", "-u", "sync_ytmusic.py"]
    last = ""
    with open(SYNC_LOG, "w") as log:
        proc = subprocess.Popen(cmd, cwd=MUSIC, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, text=True, errors="replace")
        for line in proc.stdout:
            log.write(line)
            log.flush()
            if line.strip("=\n "):
                last = line.strip()
            if not quiet:
                print(line, end="", flush=True)
        code = proc.wait()
    index_music()
    fill_songs()
    new = len(songs() - before)
    if code != 0:
        notify("YouTube Music sync failed", last)
        die(f"sync_ytmusic.py exited {code}: {last}")
    notify("YouTube Music synced", f"{new} new song{'' if new == 1 else 's'}" if new else "Nothing new")
    if not quiet:
        print(f"{new} new songs")


def cmd_music(args):
    index_music()
    filled = fill_songs()
    rows = library()
    print(f"{sum(r['audio'] for r in rows)} songs, {len(load(STATIONS, []))} stations"
          + (f", {filled} filled in" if filled else ""))


COMMANDS = {
    "open": cmd_open, "play": cmd_play, "get": cmd_get, "search": cmd_search,
    "lib": cmd_lib, "rm": cmd_rm, "mix": cmd_mix, "queue": cmd_queue, "clear": cmd_clear,
    "list": cmd_list, "led": cmd_led, "thumbs": cmd_thumbs, "status": cmd_status,
    "sync": cmd_sync, "music": cmd_music,
}


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    fn = COMMANDS.get(args[0])
    if not fn:
        die(f"unknown command {args[0]!r}; one of: {' '.join(COMMANDS)}")
    try:
        fn(args[1:])
    except RuntimeError as e:
        die(f"mpv: {e}")


if __name__ == "__main__":
    main()
