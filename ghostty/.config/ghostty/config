# Ghostty: the terminal half of the LED panel.
# Colors come from the era on screen: Dot Shell writes them to dotshell.conf
# next to this file (included at the end) and reloads Ghostty with SIGUSR2.
# No custom-shader here: the screen shader (Dot Shell, shaders/screen.glsl)
# already lays the dot mask over every window, and a second one would beat
# against it.

# ── Font ─────────────────────────────────────────────────────────────
# Departure Mono: a monospace pixel font drawn on an 11 px grid with
# 5×7-style capitals. 8.25 pt = 11 px is one font pixel per screen pixel;
# 9.75 pt = 13 px matches the rest of the desktop's 11 -> 13 bump. Pixel
# fonts are only perfectly crisp at whole multiples of 11 device px: at the
# current scale 1.2, 13.75 pt is exactly 2x (see monitor.conf).
font-family = DepartureMono Nerd Font
font-size = 9.75
font-feature = -calt
font-feature = -liga

# ── Window: no chrome ────────────────────────────────────────────────
window-decoration = none
gtk-titlebar = false
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-padding-color = extend
confirm-close-surface = false
resize-overlay = never

# Translucent so Hyprland's blur shows through, as kitty did.
background-opacity = 0.92

# ── Cursor ───────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# ── Behaviour ────────────────────────────────────────────────────────
copy-on-select = clipboard
mouse-hide-while-typing = true
app-notifications = no-clipboard-copy

# ── Era colors ───────────────────────────────────────────────────────
# Generated by Dot Shell (services/Export.qml); '?' = fine if it is missing.
config-file = ?dotshell.conf
