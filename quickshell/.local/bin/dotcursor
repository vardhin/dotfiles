#!/usr/bin/env python3
"""dotcursor: Dot Shell's cursor theme, drawn as LEDs in the era's colors.

Every cursor is pixel art on a 12x12 grid; each art pixel becomes one LED
dot (round, square or bubble, like the era's dots) with a dark rim around
the lit shape so it reads on any window. Written as one theme that both
cursor systems read:

    ~/.local/share/icons/DotShell/
        index.theme                 XCursor theme (cursors/, with aliases)
        cursors/<name>              XCursor files, 24 36 48 72 96 px
        manifest.hl                 hyprcursor theme
        hyprcursors/<shape>.hlc     hyprcursor shapes (meta.hl + PNGs),
                                    resize_algorithm = nearest

The busy cursors are animated: an LED chaser running round a ring.
Dot Shell's Export runs this on every era change, then
`hyprctl setcursor DotShell 24` and gsettings pick it up. Exits 3 without
touching anything when the colors are the same as last time.

    dotcursor --lit '#ffb347' --accent '#ffd68c' --rim '#0c0906' [--shape round|square|bubble]
              [--dest ~/.local/share/icons/DotShell]

Python standard library only (zlib, struct, zipfile).
"""
import argparse, os, shutil, struct, sys, tempfile, zipfile, zlib
from pathlib import Path

# ── Art ─────────────────────────────────────────────────────────────
# '#' lit dot, '+' accent dot, 'X' rim (dark), '.' empty. (hx, hy) is the
# hotspot in grid cells.
ART = {
