#!/usr/bin/env python3
"""dotsound: synthesize the era's UI sounds for Dot Shell.

Every era has a voice (a waveform, a pitch, an envelope, how much noise,
how mechanical) and the same eight events are played in it, so a pane
opening sounds like a flap clacking on the board, a glass chime in Frutiger Aero and
a square-wave blip on the Game Boy:

    open close toast alert flip ws shutter rec winopen winclose

Written as small WAV files (22.05 kHz, mono, 16 bit) to
    ${XDG_STATE_HOME:-~/.local/state}/dotshell/sounds/<era>/<event>.wav
Dot Shell's Export runs this on era changes; services/Sound.qml plays the
files with pw-play. An era already written is left alone (exit 3).

    dotsound --era tokyo [--dir DIR] [--force]

Python standard library only.
"""
import argparse, math, os, random, struct, sys, wave
from pathlib import Path

RATE = 22050

# ── Voices ──────────────────────────────────────────────────────────
#   wave    sine | square | pulse (12.5 %) | saw | tri | fm (bell)
#   base    root frequency (Hz) for the motifs
#   decay   seconds for a note to fall to ~5 %
#   noise   0 .. 1 noise mixed into the attack (relays, clacks, buzz)
#   click   0 .. 1 a mechanical click at every note start
#   detune  cents between two voices (chorus, tape wobble)
#   echo    0 .. 1 one echo at 180 ms (radar, glass)
#   step    semitones between motif notes
VOICES = {
    "tokyo":       dict(wave="fm", base=1046, decay=0.35, noise=0.05, click=0.0, detune=8, echo=0.25, step=7),
    "nineties":    dict(wave="saw", base=523, decay=0.18, noise=0.0, click=0.0, detune=14, echo=0.2, step=4),
    "matrix":      dict(wave="pulse", base=1318, decay=0.06, noise=0.1, click=0.2, detune=0, echo=0.0, step=-3),
    "vfd":         dict(wave="sine", base=2093, decay=0.07, noise=0.0, click=0.1, detune=0, echo=0.0, step=12),
    "aero":        dict(wave="fm", base=1568, decay=0.5, noise=0.0, click=0.0, detune=4, echo=0.35, step=5),
    "gameboy":     dict(wave="pulse", base=1046, decay=0.12, noise=0.0, click=0.0, detune=0, echo=0.0, step=7),
    "nixie":       dict(wave="tri", base=740, decay=0.05, noise=0.5, click=0.8, detune=0, echo=0.0, step=2),
    "flap":        dict(wave="tri", base=330, decay=0.03, noise=0.8, click=1.0, detune=0, echo=0.0, step=0),
    "nightvision": dict(wave="sine", base=1760, decay=0.25, noise=0.0, click=0.0, detune=0, echo=0.5, step=0),
    "vapor":       dict(wave="saw", base=392, decay=0.6, noise=0.0, click=0.0, detune=25, echo=0.4, step=3),
    "arcade":      dict(wave="square", base=988, decay=0.1, noise=0.0, click=0.0, detune=0, echo=0.0, step=12),
    "blueprint":   dict(wave="tri", base=660, decay=0.05, noise=0.6, click=0.4, detune=0, echo=0.0, step=5),
}
DEFAULT = "tokyo"


def osc(w, ph):
    x = ph % 1.0
    if w == "sine":
        return math.sin(2 * math.pi * x)
    if w == "square":
        return 1.0 if x < 0.5 else -1.0
    if w == "pulse":
        return 1.0 if x < 0.125 else -0.15
    if w == "saw":
        return 2 * x - 1
    if w == "tri":
        return 4 * abs(x - 0.5) - 1
    return math.sin(2 * math.pi * x)


def note(v, freq, dur, amp=1.0, rnd=None):
    """One note in voice v: list of floats."""
    rnd = rnd or random.Random(1)
    n = int(dur * RATE)
    out = [0.0] * n
    k = 3.0 / max(v["decay"], 0.01)
    det = 2 ** (v["detune"] / 1200)
    for i in range(n):
        t = i / RATE
        env = math.exp(-k * t) * min(1.0, t * 800)
        if v["wave"] == "fm":
            mod = math.sin(2 * math.pi * freq * 3.5 * t) * 2.2 * math.exp(-k * 1.5 * t)
            s = math.sin(2 * math.pi * freq * t + mod)
            if v["detune"]:
                s = 0.6 * s + 0.4 * math.sin(2 * math.pi * freq * det * t + mod)
        else:
            s = osc(v["wave"], freq * t)
            if v["detune"]:
                s = 0.6 * s + 0.4 * osc(v["wave"], freq * det * t)
        if v["noise"]:
            s = s * (1 - v["noise"] * math.exp(-60 * t)) + v["noise"] * (rnd.random() * 2 - 1) * math.exp(-60 * t)
        out[i] = s * env * amp
    if v["click"]:
        for i in range(min(n, int(0.004 * RATE))):
            out[i] += v["click"] * (1 if i % 2 else -1) * (1 - i / (0.004 * RATE)) * 0.6
    return out


def mix(dst, src, at):
    o = int(at * RATE)
    if o + len(src) > len(dst):
        dst.extend([0.0] * (o + len(src) - len(dst)))
    for i, s in enumerate(src):
        dst[o + i] += s


def semis(f, s):
    return f * 2 ** (s / 12)


def echo(buf, v):
    if not v["echo"]:
        return buf
    d = int(0.18 * RATE)
    out = buf + [0.0] * d
    for i in range(len(buf)):
        out[i + d] += buf[i] * v["echo"]
    return out


def clatter(v, count, span, rnd):
    """Many short mechanical clicks: the flip-disc cascade."""
    buf = []
    for i in range(count):
        t = (i / count) ** 1.3 * span + rnd.random() * 0.01
        f = v["base"] * (0.8 + rnd.random() * 0.6)
        tick = note(dict(v, noise=max(v["noise"], 0.7), click=max(v["click"], 0.6), decay=0.012), f, 0.02, 0.35 + rnd.random() * 0.3, rnd)
        mix(buf, tick, t)
    return buf


def events(v):
    rnd = random.Random(42)
    b, st = v["base"], v["step"] or 5
    # UI sounds stay short: long voices (vapor, glass) are cut to a breath.
    v = dict(v, decay=min(v["decay"], 0.22))
    ev = {}
    up = []
    mix(up, note(v, b, v["decay"] * 2.5, 0.8, rnd), 0)
    mix(up, note(v, semis(b, st), v["decay"] * 3, 0.8, rnd), 0.055)
    ev["open"] = echo(up, v)
    dn = []
    mix(dn, note(v, semis(b, st), v["decay"] * 2.5, 0.6, rnd), 0)
    mix(dn, note(v, b, v["decay"] * 3, 0.6, rnd), 0.05)
    ev["close"] = echo(dn, v)
    ch = []
    for i, s in enumerate((0, st, st * 2)):
        mix(ch, note(v, semis(b, s), v["decay"] * 4, 0.7, rnd), i * 0.08)
    ev["toast"] = echo(ch, v)
    al = []
    for i in range(3):
        mix(al, note(v, semis(b, 12), v["decay"] * 2, 0.9, rnd), i * 0.14)
        mix(al, note(v, semis(b, 6), v["decay"] * 2, 0.7, rnd), i * 0.14 + 0.07)
    ev["alert"] = al
    ev["flip"] = clatter(v, 70, 1.1, rnd)
    ws = []
    mix(ws, note(v, semis(b, -st), v["decay"] * 2, 0.5, rnd), 0)
    ev["ws"] = echo(ws, v)
    sh = []
    mix(sh, note(dict(v, noise=0.9, click=1.0, decay=0.03), b * 0.5, 0.06, 0.9, rnd), 0)
    mix(sh, note(dict(v, noise=0.9, click=1.0, decay=0.05), b * 0.4, 0.09, 0.7, rnd), 0.07)
    ev["shutter"] = sh
    rc = []
    mix(rc, note(v, semis(b, st * 2), v["decay"] * 3, 0.8, rnd), 0)
    mix(rc, note(v, semis(b, st * 2), v["decay"] * 3, 0.8, rnd), 0.18)
    ev["rec"] = rc
    # Windows (not panes): a quick three-note rise over a swell of noise,
    # like a board powering up; closing falls the other way to a low thud.
    wo = []
    mix(wo, note(dict(v, noise=max(v["noise"], 0.35), click=0.0, decay=0.09), b * 0.5, 0.12, 0.35, rnd), 0)
    for i, s in enumerate((-st, 0, st)):
        mix(wo, note(v, semis(b, s), v["decay"] * 2.2, 0.55 + i * 0.12, rnd), 0.02 + i * 0.045)
    ev["winopen"] = echo(wo, v)
    wc = []
    for i, s in enumerate((st, 0, -st)):
        mix(wc, note(v, semis(b, s), v["decay"] * 2, 0.6 - i * 0.12, rnd), i * 0.04)
    mix(wc, note(dict(v, noise=0.6, click=max(v["click"], 0.3), decay=0.05), b * 0.25, 0.1, 0.5, rnd), 0.13)
    ev["winclose"] = echo(wc, v)
    return ev


def write(path, buf):
    peak = max(1e-6, max(abs(s) for s in buf))
    # Drop the silent tail (below -46 dB).
    end = len(buf)
    while end > 1 and abs(buf[end - 1]) < peak * 0.005:
        end -= 1
    buf = buf[:end + int(0.005 * RATE)]
    g = 0.7 / peak
    # A short fade, so no file ends on a click.
    fade = int(0.01 * RATE)
    with wave.open(str(path), "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        frames = bytearray()
        for i, s in enumerate(buf):
            f = min(1.0, (len(buf) - i) / fade)
            frames += struct.pack("<h", int(max(-1, min(1, s * g * f)) * 32767))
        w.writeframes(bytes(frames))


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--era", default=DEFAULT)
    ap.add_argument("--dir", default=os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "dotshell/sounds"))
    ap.add_argument("--force", action="store_true")
    a = ap.parse_args()
    v = VOICES.get(a.era, VOICES[DEFAULT])
    out = Path(a.dir).expanduser() / a.era
    stamp = out / ".dotsound"
    key = repr(sorted(v.items())) + " v2"
    if not a.force and stamp.exists() and stamp.read_text() == key:
        return 3
    out.mkdir(parents=True, exist_ok=True)
    for name, buf in events(v).items():
        tmp = out / (name + ".wav.tmp")
        write(tmp, buf)
        tmp.replace(out / (name + ".wav"))
    stamp.write_text(key)
    return 0


if __name__ == "__main__":
    sys.exit(main())
