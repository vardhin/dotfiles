#!/usr/bin/env python3
"""dotreopen: restart Files (Nautilus) in the era's colors, windows kept.

libadwaita apps read their colors (~/.config/gtk-4.0/gtk.css, written by
Dot Shell's Export) only when they start, and GTK never reloads that file,
so a running Files window cannot follow an era change. This quits Files and
opens its windows again, each at its folder, and moves each back to the
workspace it was on. Export runs it while the windows are turned over by the
theme flip, so the restart happens out of sight.

Left alone (exit 3) while Files is busy: a copy, move or delete in progress
would be cancelled by quitting. Only the first tab of a window comes back.

    dotreopen
"""
import json, os, subprocess, sys, time

CLASS = "org.gnome.Nautilus"


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout


def clients():
    try:
        return [c for c in json.loads(run("hyprctl", "-j", "clients")) if c.get("class") == CLASS]
    except ValueError:
        return []


def running():
    return subprocess.run(["pgrep", "-x", "nautilus"], capture_output=True).returncode == 0


def main():
    if not running():
        return 0
    if "true" in run("busctl", "--user", "get-property", "org.gnome.Nautilus", "/org/gnome/Nautilus", "org.gtk.Application", "Busy"):
        print("dotreopen: Files is busy (a file operation is running); it takes the new colors when it next starts", file=sys.stderr)
        return 3
    try:
        out = run("busctl", "--user", "--json=short", "get-property", "org.freedesktop.FileManager1",
                  "/org/freedesktop/FileManager1", "org.freedesktop.FileManager1", "OpenWindowsWithLocations")
        wins = json.loads(out)["data"]
    except (ValueError, KeyError):
        wins = {}
    # Window object paths end in a creation counter: reopen in that order.
    order = sorted(wins, key=lambda p: int(p.rsplit("/", 1)[-1]) if p.rsplit("/", 1)[-1].isdigit() else 0)
    uris = [wins[p][0] for p in order if wins[p]]
    before = clients()

    subprocess.run(["nautilus", "--quit"], capture_output=True)
    for _ in range(40):
        if not running():
            break
        time.sleep(0.05)
    if not uris:
        return 0

    for u in uris:
        subprocess.Popen(["nautilus", "--new-window", u], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    after = []
    for _ in range(60):
        after = clients()
        if len(after) >= len(uris):
            break
        time.sleep(0.05)

    # Back to their workspaces, matched by title (the folder's name).
    lua = '"lua"' in run("hyprctl", "-j", "status")
    olds = list(before)
    for c in after:
        old = next((o for o in olds if o.get("title") == c.get("title")), None)
        if not old:
            continue
        olds.remove(old)
        ws, addr = old["workspace"]["name"], c["address"]
        if ws == c["workspace"]["name"]:
            continue
        if lua:
            run("hyprctl", "dispatch", 'hl.dsp.window.move({ workspace = %s, follow = false, window = "address:%s" })' % (json.dumps(ws), addr))
        else:
            run("hyprctl", "dispatch", "movetoworkspacesilent", "%s,address:%s" % (ws, addr))
    return 0


if __name__ == "__main__":
    sys.exit(main())
