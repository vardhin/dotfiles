#!/usr/bin/env bash
# dotws: switch workspace through Dot Shell, so the switch can dissolve.
#   dotws go 3 | e+1 | e-1 | previous | empty
#   dotws move 3      move the focused window there and follow it
# Sends {"cmd":"ws",…} on the dot socket (socat: ~5 ms, against ~30 ms for
# `qs ipc`). Without Dot Shell it falls back to hyprctl.
set -u
verb=${1:-go} arg=${2:-}
sock=${XDG_RUNTIME_DIR:-/tmp}/dotshell.sock
if [[ -S $sock ]] && printf '{"cmd":"ws","%s":"%s"}\n' "$verb" "$arg" | socat -t1 - "UNIX-CONNECT:$sock" 2>/dev/null | grep -q '"ok":true'; then
  exit 0
fi
case $verb in
  move) exec hyprctl dispatch movetoworkspace "$arg" ;;
  *) exec hyprctl dispatch workspace "$arg" ;;
esac
