#!/usr/bin/env -S python3 -I
# dotd extractor: a 320 px thumbnail per content hash, in $DOTD_THUMBS, for
# the launcher and the Files panel. vipsthumbnail for images, a frame at
# 10% for videos, the first page for PDFs.
import json, os, subprocess, sys
p = sys.argv[1]
mime = os.environ.get("DOTD_MIME", "")
out = os.path.join(os.environ["DOTD_THUMBS"], os.environ["DOTD_HASH"] + ".png")
if mime.startswith("video/"):
    d = subprocess.run(["ffprobe", "-v", "quiet", "-show_entries", "format=duration", "-of", "csv=p=0", p],
                       capture_output=True, text=True).stdout.strip()
    at = str(float(d) * 0.1) if d else "0"
    cmd = ["ffmpeg", "-v", "quiet", "-y", "-ss", at, "-i", p, "-frames:v", "1", "-vf", "scale=320:-2", out]
elif mime == "application/pdf":
    cmd = ["pdftoppm", "-png", "-singlefile", "-l", "1", "-scale-to", "320", p, out[:-4]]
else:
    cmd = ["vipsthumbnail", p, "--size", "320", "-o", out]
subprocess.run(cmd, capture_output=True, timeout=55)
if not os.path.exists(out):
    sys.exit(1)
print(json.dumps({"meta": {"thumb": out}}))
